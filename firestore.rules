rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Primitives & Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      // Bootstrapped admin check
      return isSignedIn() && (
        request.auth.token.email == 'nsujannayaka99@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Helpers
    function isValidProduct(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.price is number && data.price >= 0 &&
             data.category is string &&
             data.inventory is int;
    }

    function isValidOrder(data) {
      return data.userId == request.auth.uid &&
             data.items is list && data.items.size() > 0 &&
             data.total is number &&
             data.status in ['pending', 'processing', 'shipped', 'delivered', 'cancelled'] &&
             data.createdAt == request.time;
    }

    function isValidActivity(data) {
      return data.userId == request.auth.uid &&
             data.productId is string &&
             data.action in ['view', 'add_to_cart', 'purchase'] &&
             data.timestamp == request.time;
    }

    function isValidUser(data) {
      return data.email == request.auth.token.email &&
             data.role in ['customer', 'admin'];
    }

    // 3. Collections

    // Products: Anyone can read, only admin can write
    match /products/{productId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidProduct(incoming());
      allow delete: if isAdmin();
    }

    // Orders: Private read (owner/admin), create (authenticated/verified)
    match /orders/{orderId} {
      allow read: if isAdmin() || isUser(existing().userId);
      allow create: if isEmailVerified() && isValidOrder(incoming());
      allow update: if isAdmin(); // Only admin can update status e.g.
      allow delete: if isAdmin();
    }

    // UserActivity: Owner or Admin
    match /userActivity/{activityId} {
      allow read: if isAdmin() || isUser(existing().userId);
      allow create: if isSignedIn() && isValidActivity(incoming());
      allow delete: if isAdmin();
    }

    // User Profiles
    match /users/{userId} {
      allow read: if isUser(userId) || isAdmin();
      allow create: if isUser(userId) && isEmailVerified() && isValidUser(incoming()) && incoming().role == 'customer';
      allow update: if (isUser(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']) && incoming().updatedAt == request.time) || isAdmin();
    }

    // Admins collection (lookup)
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; // Only manageable via Firebase Console or special script
    }
  }
}
