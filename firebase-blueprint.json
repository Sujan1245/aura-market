{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "An item for sale in the store.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "imageUrl": { "type": "string" },
        "inventory": { "type": "integer" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "price", "category", "inventory"]
    },
    "Order": {
      "title": "Order",
      "description": "A customer's purchase.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "processing", "shipped", "delivered", "cancelled"] },
        "shippingAddress": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "items", "total", "status", "createdAt"]
    },
    "UserActivity": {
      "title": "UserActivity",
      "description": "Log of user interactions for recommendations.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "productId": { "type": "string" },
        "action": { "type": "string", "enum": ["view", "add_to_cart", "purchase"] },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "productId", "action", "timestamp"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Extended user information.",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["customer", "admin"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "products": {
      "schema": "Product",
      "description": "Store items available for purchase."
    },
    "orders": {
      "schema": "Order",
      "description": "Customer purchase records."
    },
    "userActivity": {
      "schema": "UserActivity",
      "description": "Tracking logs for AI recommendations."
    },
    "users": {
      "schema": "UserProfile",
      "description": "User profile data."
    }
  }
}
